# Retrivium — Environment Variables Template
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local to version control.

# ── Supabase ──────────────────────────────────────
# Your Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Your Supabase anonymous (publishable) key (Settings → API → anon public)
VITE_SUPABASE_PUBLISHABLE_KEY=
